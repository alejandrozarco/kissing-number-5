theorem cA4_nonneg (k m : ℕ) : 0 ≤ cA4 k m := by
  unfold cA4
  split <;> norm_num

theorem add4_0 (a a' w P Q : ℝ) :
    Zg 4 0 (a * a' + w) (a * a + P) (a' * a' + Q) = ∑ m ∈ Finset.range 1,
      cA4 0 m * Zg (4 + 2 * m) (0 - m) a (a * a + P) 1 * Zg (4 + 2 * m) (0 - m) a' (a' * a' + Q) 1
        * Zg 3 m w P Q := by
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, Nat.reduceAdd, Nat.reduceMul, Nat.reduceSub]
  simp only [cA4, Zg]
  push_cast
  ring

