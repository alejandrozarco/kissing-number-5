import Kissing5.Addition3_8

/-! Solid Gegenbauer addition identities from `ℝ^4` to `ℝ^3`, degrees `k ∈ 0..6`.

Generated by `lean/gen/gen_addition5.py` (every identity is first checked with sympy). Do not edit; regenerate.

For `x = (a, y)`, `x' = (a', y')` with `y, y' ∈ ℝ^3`, `w = ⟪y, y'⟫`, `P = ‖y‖²`, `Q = ‖y'‖²`:
`Zg 4 k ⟪x, x'⟫ ‖x‖² ‖x'‖² = ∑_{m ≤ k} cA4 k m · B(a) · B(a') · Z_m(w, P, Q)` with
`B(a) = Zg (4 + 2m) (k - m) a ‖x‖² 1` and `Z_m` the kernel of `ℝ^3`. -/

namespace Kissing5

open Kissing8

/-- The coefficients of the identities from `ℝ^4` (`0` outside `m ≤ k ≤ 8`). -/
noncomputable def cA4 : ℕ → ℕ → ℝ
  | 0, 0 => 1
  | 1, 0 => 1/2
  | 1, 1 => 2
  | 2, 0 => 1/6
  | 2, 1 => 1
  | 2, 2 => 8/3
